{
  "name": "dsh-extension-cdp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Attach the DSH Chrome DevTools MCP client to the browser you are already running (Edge or Chrome) so extension debugging tools toggle on and off with one row.",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./connect.mjs": "./connect.mjs", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "scripts": { "test": "node --test \"test/*.test.mjs\"" },
  "engines": { "node": ">=22.15" },
  "files": ["index.js", "client.js", "connect.mjs", "lib/**", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg", "test/**", "tools/*.mjs"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"] }
  }
}
